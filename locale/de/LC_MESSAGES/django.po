msgid "Centro de Gestión › Mi Disponibilidad"
msgstr "Verwaltungszentrum › Meine Verfügbarkeit"

msgid ""
"Indica tus horas libres para que coordinación pueda agendar reuniones o "
"citas contigo."
msgstr ""
"Geben Sie Ihre freien Stunden an, damit die Koordination Besprechungen oder "
"Termine mit Ihnen vereinbaren kann."

msgid "Evaluación y calificación"
msgstr "Bewertung und Benotung"

msgid "Categorías de Actividad"
