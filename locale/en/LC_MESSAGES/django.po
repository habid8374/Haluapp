#: gestion_academica/models.py:795 simat/views.py:929
msgid "País de origen"
msgstr "Country of origin"

#: admisiones/forms.py:20
msgid "Elige el país del aspirante (incluida Colombia). No se completa solo."
msgstr ""
"Choose the applicant's country (including Colombia). It is not filled in "
"automatically."

#: admisiones/forms.py:80 gestion_academica/models.py:867
msgid "Primer nombre"
msgstr "First name"

#: admisiones/forms.py:82 gestion_academica/models.py:868
msgid "Segundo nombre"
msgstr "Middle name"

#: admisiones/forms.py:84 gestion_academica/models.py:869
msgid "Primer apellido"
msgstr "First surname"

#: admisiones/forms.py:86 gestion_academica/models.py:870
msgid "Segundo apellido"
msgstr "Second surname"

#: admisiones/forms.py:117
msgid "1. Datos del estudiante"
msgstr "1. Student data"

#: admisiones/forms.py:124
msgid "2. Contacto"
msgstr "2. Contact"

#: admisiones/forms.py:128
msgid "3. Matrícula"
msgstr "3. Enrollment"

#: admisiones/forms.py:135
msgid "4. Nacimiento y residencia"
msgstr "4. Birth and residence"

#: admisiones/forms.py:143
msgid "5. Salud y discapacidad"
msgstr "5. Health and disability"

#: admisiones/forms.py:148
msgid "6. Pertenencia étnica"
msgstr "6. Ethnic identity"

#: admisiones/forms.py:152
msgid "7. Caracterización socio-económica (SIMPADE)"
msgstr "7. Socio-economic profile (SIMPADE)"

#: admisiones/forms.py:162
msgid "8. Matrícula SIMAT (reporte oficial)"
msgstr "8. SIMAT enrollment (official report)"

#: admisiones/forms.py:169
msgid "9. Acudiente / Familiar"
msgstr "9. Guardian / Family member"

#: admisiones/forms.py:252
msgid "¿Generar cobro de inscripción para este aspirante?"
msgstr "Generate an enrollment charge for this applicant?"

#: admisiones/forms.py:253 gestion_academica/forms.py:300
#: gestion_academica/models.py:539
msgid "Grupo Sanguíneo"
msgstr "Blood type"

#: admisiones/forms.py:256
msgid ""
"Marque esta casilla si debe crearse una cuenta por cobrar para la "
"inscripción."
msgstr ""
"Check this box if an account receivable should be created for the "
"enrollment."

#: admisiones/forms.py:257
msgid ""
"Opcional. Describe brevemente si el aspirante tiene alguna condición de "
"salud o discapacidad."
msgstr ""
"Optional. Briefly describe if the applicant has any health condition or "
"disability."

#: admisiones/forms.py:293
msgid "Selecciona un archivo Excel (.xlsx)"
msgstr "Select an Excel file (.xlsx)"

#: admisiones/forms.py:309
msgid "Modo simulación (no crear registros, solo validar)"
msgstr "Simulation mode (do not create records, only validate)"

#: admisiones/forms.py:310
msgid ""
"Recomendado en la primera carga: valida el archivo y muestra errores fila "
"por fila sin crear aspirantes."
msgstr ""
"Recommended on the first upload: it validates the file and shows errors row "
"by row without creating applicants."

#: admisiones/views.py:464
msgid ""
"No se pudo generar la plantilla de Excel en este momento. Vuelve a "
"intentarlo; si el problema persiste, avísale al soporte."
msgstr ""
"The Excel template could not be generated right now. Please try again; if "
"the problem persists, contact support."

